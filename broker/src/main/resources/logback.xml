<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_DIR" value="${DATA_DIR:-./data}" />
    <property name="BROKER_APP_LOG_LEVEL" value="${BROKER_APP_LOG_LEVEL:-INFO}" />
    <property name="BROKER_DELIVERY_LOG_LEVEL" value="${BROKER_DELIVERY_LOG_LEVEL:-INFO}" />
    <property name="BROKER_ACK_LOG_LEVEL" value="${BROKER_ACK_LOG_LEVEL:-INFO}" />
    <property name="BROKER_REFRESH_LOG_LEVEL" value="${BROKER_REFRESH_LOG_LEVEL:-INFO}" />
    <property name="BROKER_LEGACY_LOG_LEVEL" value="${BROKER_LEGACY_LOG_LEVEL:-INFO}" />
    <property name="BROKER_COMPACTION_LOG_LEVEL" value="${BROKER_COMPACTION_LOG_LEVEL:-INFO}" />
    <property name="BROKER_PIPE_LOG_LEVEL" value="${BROKER_PIPE_LOG_LEVEL:-INFO}" />

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level trace=%X{traceId:-na} %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="INFO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/broker.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/broker.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>25MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level trace=%X{traceId:-na} %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="DEBUG_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/broker-debug.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/broker-debug.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>DEBUG</level>
        </filter>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{48} trace=%X{traceId:-na} topic=%X{topic:-na} group=%X{group:-na} client=%X{clientId:-na} refresh=%X{refreshId:-na} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="ASYNC_INFO" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>8192</queueSize>
        <discardingThreshold>20</discardingThreshold>
        <appender-ref ref="INFO_FILE"/>
    </appender>

    <appender name="ASYNC_DEBUG" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>16384</queueSize>
        <discardingThreshold>50</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="DEBUG_FILE"/>
    </appender>

    <logger name="com.messaging.broker" level="${BROKER_APP_LOG_LEVEL}"/>
    <logger name="com.messaging.broker.consumer.BatchDeliveryService" level="${BROKER_DELIVERY_LOG_LEVEL}"/>
    <logger name="com.messaging.broker.consumer.BatchAckService" level="${BROKER_ACK_LOG_LEVEL}"/>
    <logger name="com.messaging.broker.consumer.RefreshReplayService" level="${BROKER_REFRESH_LOG_LEVEL}"/>
    <logger name="com.messaging.broker.legacy.LegacyConsumerDeliveryManager" level="${BROKER_LEGACY_LOG_LEVEL}"/>
    <logger name="com.messaging.broker.compaction.CompactionScheduler" level="${BROKER_COMPACTION_LOG_LEVEL}"/>
    <logger name="com.messaging.broker.compaction.CompactionRewriter" level="${BROKER_COMPACTION_LOG_LEVEL}"/>
    <logger name="com.messaging.pipe" level="${BROKER_PIPE_LOG_LEVEL}"/>
    <logger name="com.messaging.storage.filechannel" level="INFO"/>
    <logger name="com.messaging.network.codec" level="INFO"/>
    <logger name="com.messaging.network.tcp" level="INFO"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="io.micronaut" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="ASYNC_INFO"/>
        <appender-ref ref="ASYNC_DEBUG"/>
    </root>
</configuration>
